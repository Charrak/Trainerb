# Local development only; copy to .env and generate five DIFFERENT random keys.
APP_ENV=development
DATABASE_URL=postgresql://trainerb:trainerb-local-only@127.0.0.1:5432/trainerb_dev
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_BASE_URL=http://localhost:3000
# API port and where the web server proxies /api/v1 to (browser code never sees it).
API_PORT=4000
# API_INTERNAL_ORIGIN=http://127.0.0.1:4000
# Comma-separated extra origins the Next dev server accepts (preview proxies).
# ALLOWED_DEV_ORIGINS=*.e2b.app
ALLOW_INSECURE_LOCAL_HTTP=true
# Optional: a separately privileged role for migrations. Falls back to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://trainerb:trainerb-local-only@127.0.0.1:5432/trainerb_dev
# Each key must be an independent 32-byte base64 value; use `openssl rand -base64 32`.
SESSION_HMAC_KEY=
CSRF_HMAC_KEY=
TOKEN_HMAC_KEY=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=dev-1
# Optional mounted secret file with additional read-only keys. Never commit it.
DATA_DECRYPTION_KEYS_FILE=
AUDIT_PSEUDONYMIZATION_KEY=
MAIL_FROM=akademie@example.invalid
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# TRUST_PROXY_CIDRS=loopback
COMMON_PASSWORDS_FILE=packages/database/data/common-passwords.txt.gz
# Web build: only set to live for an explicitly released production deployment.
# NEXT_PUBLIC_SITE_STAGE=live
# Optional card payment (Stripe test mode only). Leave empty to disable the
# card option; the invoice/transfer path works without these values.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# First superadmin. Only the local bootstrap script reads these; there is no
# default password and the account activates itself through the normal link.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=
# Isolated test database/Redis; integration tests DELETE test data.
TEST_DATABASE_URL=postgresql://trainerb:trainerb-local-only@127.0.0.1:5432/trainerb_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15
# Optional: private learning media. Path-style S3, separate HTTPS origin,
# private bucket, dedicated GetObject-only credentials. No public bucket ACL.
# MEDIA_S3_ENDPOINT=https://objects.example.invalid
# MEDIA_S3_BUCKET=learning-private
# MEDIA_S3_REGION=eu-central-1
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# Optional ingestion on the same HTTPS endpoint. Separate PRIVATE bucket,
# separate PutObject-only writer; never grant the delivery reader access here.
# MEDIA_QUARANTINE_BUCKET=learning-quarantine
# MEDIA_QUARANTINE_ACCESS_KEY_ID=
# MEDIA_QUARANTINE_SECRET_ACCESS_KEY=
# Optional, scan process only: separate GetObject-only identity for quarantine,
# and a local Unix socket of a maintained ClamAV daemon.
# MEDIA_SCAN_ACCESS_KEY_ID=
# MEDIA_SCAN_SECRET_ACCESS_KEY=
# MEDIA_SCAN_CLAMD_SOCKET=/run/clamav/clamd.ctl
# Separate promotion worker only (do not load API, scan or upload credentials).
# Same endpoint/region, MEDIA_QUARANTINE_BUCKET = GET, MEDIA_S3_BUCKET = PUT.
# MEDIA_PROMOTE_ACCESS_KEY_ID=
# MEDIA_PROMOTE_SECRET_ACCESS_KEY=
