generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @db.Uuid
  email_original    String?   @db.Text
  email_canonical   String?   @unique @db.Text
  email_verified_at DateTime? @db.Timestamptz(6)
  password_hash     String?   @db.Text
  first_name        String?   @db.Text
  last_name         String?   @db.Text
  locale            String    @default("de-DE") @db.Text
  status            String    @db.Text
  last_login_at     DateTime? @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  quarantine_uploads CourseMediaUpload[] @relation("MediaUploader")
  media_approvals CourseMediaUpload[] @relation("MediaApprover")
  uploaded_media   MediaAsset[]
  billing_profiles BillingProfile[]
  roles            UserRole[]             @relation("RoleSubject")
  grants           UserRole[]             @relation("RoleGranter")
  mfa_factors      UserMfaFactor[]
  sessions         AuthSession[]
  tokens           AccountToken[]
  audit_events     AuditEvent[]           @relation("AuditActor")
  template_versions EmailTemplateVersion[] @relation("TemplateAuthor")
  outbox           EmailOutbox[]
  course_assignments CourseStaff[] @relation("CourseStaffUser")
  course_assignments_given CourseStaff[] @relation("CourseStaffAssigner")
  course_versions_created CourseVersion[] @relation("CourseVersionCreator")
  course_versions_published CourseVersion[] @relation("CourseVersionPublisher")
  products_created Product[] @relation("ProductCreator")
  products_activated Product[] @relation("ProductActivator")
  course_publications CoursePublication[] @relation("PublicationActor")
  prices_created Price[] @relation("PriceCreator")
  carts Cart[] @relation("CartOwner")
  orders_bought Order[] @relation("OrderBuyer")
  orders_created Order[] @relation("OrderCreator")
  orders_confirmed Order[] @relation("OrderConfirmer")
  coupons_created Coupon[] @relation("CouponCreator")
  coupon_reservations CouponReservation[] @relation("CouponReservationUser")
  course_accesses CourseAccess[] @relation("CourseAccessUser")
  course_access_granted CourseAccess[] @relation("CourseAccessGranter")
  legal_versions_activated LegalDocumentVersion[] @relation("LegalActivator")
  commerce_settings CommerceSettings[] @relation("CommerceSettingsEditor")
  refunds_requested Refund[] @relation("RefundRequester")
  access_decisions  OrderAccessDecision[] @relation("AccessDecisionMaker")
  withdrawal_requests_processed WithdrawalRequest[] @relation("WithdrawalProcessor")
  tax_rates_created            TaxRate[]            @relation("TaxRateCreator")

  @@map("users")
}

model BillingProfile {
  id           String    @id @db.Uuid
  user_id      String    @db.Uuid
  company      String?   @db.Text
  first_name   String    @db.Text
  last_name    String    @db.Text
  street       String    @db.Text
  street_extra String?   @db.Text
  postal_code  String    @db.Text
  city         String    @db.Text
  region       String?   @db.Text
  country      String    @db.Char(2)
  vat_id       String?   @db.Text
  is_default   Boolean   @default(false)
  archived_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@index([user_id])
  @@map("billing_profiles")
}

model Role {
  id          String           @id @db.Uuid
  key         String           @unique @db.Text
  name        String           @db.Text
  is_system   Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  key         String           @unique @db.Text
  description String           @db.Text
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  roles       RolePermission[]
  @@map("permissions")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  granted_at    DateTime   @default(now()) @db.Timestamptz(6)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Restrict)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)
  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  granted_by String?  @db.Uuid
  granted_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation("RoleSubject", fields: [user_id], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Restrict)
  granter    User?    @relation("RoleGranter", fields: [granted_by], references: [id], onDelete: Restrict)
  @@id([user_id, role_id])
  @@index([role_id])
  @@index([granted_by])
  @@map("user_roles")
}

model UserMfaFactor {
  id                 String    @id @db.Uuid
  user_id            String    @db.Uuid
  type               String    @db.Text
  status             String    @db.Text
  secret_ciphertext  Bytes
  key_id             String    @db.Text
  confirmed_at       DateTime? @db.Timestamptz(6)
  last_used_at       DateTime? @db.Timestamptz(6)
  last_accepted_step BigInt?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  recovery_codes     MfaRecoveryCode[]
  @@index([user_id])
  @@map("user_mfa_factors")
}

model MfaRecoveryCode {
  id         String        @id @db.Uuid
  factor_id  String        @db.Uuid
  code_hash  Bytes         @unique
  used_at    DateTime?     @db.Timestamptz(6)
  expires_at DateTime?     @db.Timestamptz(6)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  factor     UserMfaFactor @relation(fields: [factor_id], references: [id], onDelete: Restrict)
  @@index([factor_id])
  @@map("mfa_recovery_codes")
}

model AuthSession {
  id                 String    @id @db.Uuid
  user_id            String    @db.Uuid
  kind               String    @db.Text
  token_hash         Bytes     @unique
  csrf_secret_hash   Bytes
  mfa_verified_at    DateTime? @db.Timestamptz(6)
  reauthenticated_at DateTime? @db.Timestamptz(6)
  last_seen_at       DateTime  @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  ip_hmac            Bytes?
  user_agent_hmac    Bytes?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@index([user_id])
  @@index([expires_at])
  @@map("auth_sessions")
}

model AccountToken {
  id                     String    @id @db.Uuid
  user_id                String    @db.Uuid
  purpose                String    @db.Text
  token_hash             Bytes     @unique
  target_email_original  String?   @db.Text
  target_email_canonical String?   @db.Text
  expires_at             DateTime  @db.Timestamptz(6)
  used_at                DateTime? @db.Timestamptz(6)
  revoked_at             DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@index([user_id, purpose])
  @@map("account_tokens")
}

model AuditEvent {
  id            String   @id @db.Uuid
  actor_user_id String?  @db.Uuid
  origin        String   @db.Text
  action        String   @db.Text
  target_type   String   @db.Text
  target_ref    String   @db.Text
  before_safe   Json?
  after_safe    Json?
  reason_code   String?  @db.Text
  request_id    String?  @db.Uuid
  ip_hmac       Bytes?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  actor         User?    @relation("AuditActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  @@index([actor_user_id])
  @@index([target_type, target_ref])
  @@map("audit_events")
}

model EmailTemplate {
  id         String                 @id @db.Uuid
  key        String                 @db.Text
  locale     String                 @db.Text
  status     String                 @db.Text
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  updated_at DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  versions   EmailTemplateVersion[]
  @@unique([key, locale])
  @@map("email_templates")
}

model EmailTemplateVersion {
  id                 String        @id @db.Uuid
  template_id        String        @db.Uuid
  version            Int
  state              String        @db.Text
  subject_template   String        @db.Text
  body_html_template String        @db.Text
  body_text_template String        @db.Text
  allowed_variables  Json
  created_by         String?       @db.Uuid
  published_at       DateTime?     @db.Timestamptz(6)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  template           EmailTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)
  author             User?         @relation("TemplateAuthor", fields: [created_by], references: [id], onDelete: Restrict)
  outbox             EmailOutbox[]
  @@unique([template_id, version])
  @@index([created_by])
  @@map("email_template_versions")
}

model EmailOutbox {
  id                          String               @id @db.Uuid
  template_version_id         String               @db.Uuid
  purpose                     String               @db.Text
  user_id                     String?              @db.Uuid
  to_email                    String               @db.Text
  variables_public            Json
  variables_secret_ciphertext Bytes?
  secret_key_id               String?              @db.Text
  secret_delete_after         DateTime?            @db.Timestamptz(6)
  idempotency_key             String               @unique @db.Text
  status                      String               @db.Text
  attempts                    Int                  @default(0)
  scheduled_at                DateTime             @db.Timestamptz(6)
  sent_at                     DateTime?            @db.Timestamptz(6)
  provider                    String?              @db.Text
  provider_message_id         String?              @db.Text
  last_error_safe             String?              @db.Text
  created_at                  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  template_version            EmailTemplateVersion @relation(fields: [template_version_id], references: [id], onDelete: Restrict)
  user                        User?                @relation(fields: [user_id], references: [id], onDelete: Restrict)
  withdrawal_requests         WithdrawalRequest[]
  @@index([template_version_id])
  @@index([user_id])
  @@index([status, scheduled_at])
  @@map("email_outbox")
}

model AutomationJob {
  id                     String    @id @db.Uuid
  kind                   String    @db.Text
  ref_type               String    @db.Text
  ref_id                 String?   @db.Uuid
  payload_schema_version Int       @db.SmallInt
  payload                Json
  idempotency_key        String    @unique @db.Text
  status                 String    @db.Text
  wait_reason            String?   @db.Text
  attempts               Int       @default(0)
  max_attempts           Int
  run_after              DateTime  @db.Timestamptz(6)
  lease_until            DateTime? @db.Timestamptz(6)
  finished_at            DateTime? @db.Timestamptz(6)
  last_error_safe        String?   @db.Text
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  job_attempts           AutomationJobAttempt[]
  @@index([status, run_after])
  @@map("automation_jobs")
}

model AutomationJobAttempt {
  id                String        @id @db.Uuid
  automation_job_id String        @db.Uuid
  attempt_no        Int
  started_at        DateTime      @db.Timestamptz(6)
  finished_at       DateTime      @db.Timestamptz(6)
  result            String        @db.Text
  error_safe        String?       @db.Text
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  job               AutomationJob @relation(fields: [automation_job_id], references: [id], onDelete: Restrict)
  @@unique([automation_job_id, attempt_no])
  @@map("automation_job_attempts")
}

// Source-specific and publication constraints are enforced in SQL.
model CourseMediaUpload {
  id            String   @id @db.Uuid
  course_id     String   @db.Uuid
  uploaded_by   String   @db.Uuid
  object_key    String   @unique @db.Uuid
  original_name String   @db.Text
  mime_detected String   @db.Text
  size_bytes    Int
  sha256        Bytes
  status        String   @default("pending_scan") @db.Text
  scanned_at    DateTime? @db.Timestamptz(6)
  scan_error    String?   @db.Text
  approved_by   String?   @db.Uuid
  approved_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  course        Course   @relation(fields: [course_id], references: [id], onDelete: Restrict)
  promoted_asset_id String? @unique @db.Uuid
  promoted_asset MediaAsset? @relation(fields: [promoted_asset_id], references: [id], onDelete: Restrict)
  promotion_error String? @db.Text
  approver      User?    @relation("MediaApprover", fields: [approved_by], references: [id], onDelete: Restrict)
  @@index([approved_by])
  uploader      User     @relation("MediaUploader", fields: [uploaded_by], references: [id], onDelete: Restrict)
  @@index([course_id])
  @@index([uploaded_by])
  @@map("course_media_uploads")
}

model MediaAsset {
  source_upload CourseMediaUpload?
  id                String    @id @db.Uuid
  source            String    @db.Text
  storage_key       String?   @unique @db.Text
  video_external_id String?   @unique @db.Text
  original_name     String    @db.Text
  mime_detected     String    @db.Text
  size_bytes        BigInt
  sha256            Bytes?
  visibility        String    @default("private") @db.Text
  status            String    @default("pending_scan") @db.Text
  uploaded_by       String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  uploader          User?     @relation(fields: [uploaded_by], references: [id], onDelete: Restrict)
  @@index([uploaded_by])
  covers             CourseVersion[]
  chapter_contents   ChapterContent[]
  @@map("media_assets")
}

// Phase 2 foundation. Publishing is deliberately locked in the SQL migration
// until the corresponding checks and later exam/certificate model exist.
model Course {
  id         String          @id @db.Uuid
  slug       String          @unique @db.Text
  status     String          @default("draft") @db.Text
  visibility String          @default("private") @db.Text
  sort_order Int             @default(0)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  versions   CourseVersion[]
  staff      CourseStaff[]
  products   ProductCourse[]
  publications CoursePublication[]
  order_item_courses OrderItemCourse[]
  accesses CourseAccess[]
  quarantine_uploads CourseMediaUpload[]
  @@map("courses")
}

model CourseVersion {
  id                         String          @id @db.Uuid
  course_id                  String          @db.Uuid
  version                    Int
  state                      String          @default("draft") @db.Text
  title                      String          @db.Text
  subtitle                   String?         @db.Text
  description                Json
  duration_minutes           Int?
  default_access_days        Int?
  chapter_completion_mode    String          @default("self_confirm") @db.Text
  completion_profile         String?         @db.Text
  expected_module_count      Int?
  expected_chapter_count     Int?
  expected_exams_per_chapter Int?
  content_schema_version     Int             @default(1) @db.SmallInt
  revision                   Int             @default(1)
  created_by                 String          @db.Uuid
  published_by               String?         @db.Uuid
  published_at               DateTime?       @db.Timestamptz(6)
  created_at                 DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  course                     Course          @relation(fields: [course_id], references: [id], onDelete: Restrict)
  creator                    User            @relation("CourseVersionCreator", fields: [created_by], references: [id], onDelete: Restrict)
  publisher                  User?           @relation("CourseVersionPublisher", fields: [published_by], references: [id], onDelete: Restrict)
  modules                    CourseModule[]
  chapters                   CourseChapter[]
  contents                   ChapterContent[]
  publications               CoursePublication[]
  order_item_courses         OrderItemCourse[]
  accesses                   CourseAccess[]
  chapter_progress           ChapterProgress[]
  @@unique([course_id, version])
  @@unique([id, course_id])
  @@index([created_by])
  @@index([published_by])
  cover_media_id             String?         @db.Uuid
  cover_media                MediaAsset?     @relation(fields: [cover_media_id], references: [id], onDelete: Restrict)
  @@index([cover_media_id])
  @@map("course_versions")
}

model CourseModule {
  id                String          @id @db.Uuid
  course_version_id String          @db.Uuid
  title             String          @db.Text
  description       String?         @db.Text
  position          Int
  revision          Int             @default(1)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  course_version    CourseVersion   @relation(fields: [course_version_id], references: [id], onDelete: Restrict)
  chapters          CourseChapter[]
  @@unique([course_version_id, position])
  @@unique([id, course_version_id])
  @@map("course_modules")
}

model CourseChapter {
  exams             Exam[]
  id                String         @id @db.Uuid
  course_version_id String         @db.Uuid
  module_id         String         @db.Uuid
  title             String         @db.Text
  summary           String?        @db.Text
  estimated_minutes Int?
  position          Int
  revision          Int            @default(1)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  course_version    CourseVersion  @relation(fields: [course_version_id], references: [id], onDelete: Restrict)
  module            CourseModule   @relation(fields: [module_id, course_version_id], references: [id, course_version_id], onDelete: Restrict)
  contents          ChapterContent[]
  progress          ChapterProgress[]
  @@unique([module_id, position])
  @@unique([id, course_version_id])
  @@index([course_version_id])
  @@map("course_chapters")
}

model ChapterContent {
  id                String        @id @db.Uuid
  course_version_id String        @db.Uuid
  chapter_id        String        @db.Uuid
  kind              String        @default("text") @db.Text
  title             String?       @db.Text
  body              Json?
  media_asset_id    String?       @db.Uuid
  media_asset       MediaAsset?   @relation(fields: [media_asset_id], references: [id], onDelete: Restrict)
  @@index([media_asset_id])
  position          Int
  revision          Int           @default(1)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  course_version    CourseVersion @relation(fields: [course_version_id], references: [id], onDelete: Restrict)
  chapter           CourseChapter @relation(fields: [chapter_id, course_version_id], references: [id, course_version_id], onDelete: Restrict)
  @@unique([chapter_id, position])
  @@index([course_version_id])
  @@map("chapter_contents")
}

model CourseStaff {
  course_id  String   @db.Uuid
  user_id    String   @db.Uuid
  scope_role String   @db.Text
  assigned_by String  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  course     Course   @relation(fields: [course_id], references: [id], onDelete: Restrict)
  user       User     @relation("CourseStaffUser", fields: [user_id], references: [id], onDelete: Restrict)
  assigner   User     @relation("CourseStaffAssigner", fields: [assigned_by], references: [id], onDelete: Restrict)
  @@id([course_id, user_id, scope_role])
  @@index([user_id, scope_role])
  @@index([assigned_by])
  @@map("course_staff")
}

// Private catalog drafts. The SQL migration locks activation and currency.
model Product {
  id           String          @id @db.Uuid
  sku          String          @unique @db.Text
  type         String          @db.Text
  title        String          @db.Text
  variant_name String?         @db.Text
  description  String?         @db.Text
  status       String          @default("draft") @db.Text
  activated_at DateTime?       @db.Timestamptz(6)
  activated_by String?         @db.Uuid
  sort_order   Int             @default(0)
  revision     Int             @default(1)
  created_by   String          @db.Uuid
  created_at   DateTime        @default(now()) @db.Timestamptz(6)
  updated_at   DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  creator      User            @relation("ProductCreator", fields: [created_by], references: [id], onDelete: Restrict)
  activator    User?           @relation("ProductActivator", fields: [activated_by], references: [id], onDelete: Restrict)
  courses      ProductCourse[]
  prices       Price[]
  cart_items   CartItem[]
  order_items  OrderItem[]
  coupon_links CouponProduct[]
  @@index([created_by])
  @@index([created_at, id])
  @@map("products")
}

model ProductCourse {
  product_id           String   @db.Uuid
  course_id            String   @db.Uuid
  position             Int
  access_days_override Int?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  product              Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  course               Course   @relation(fields: [course_id], references: [id], onDelete: Restrict)
  @@id([product_id, course_id])
  @@unique([product_id, position])
  @@index([course_id])
  @@map("product_courses")
}

model Price {
  id               String    @id @db.Uuid
  product_id       String    @db.Uuid
  currency         String    @db.Char(3)
  model            String    @default("one_time") @db.Text
  gross_cents      BigInt
  sale_gross_cents BigInt?
  sale_starts_at   DateTime? @db.Timestamptz(6)
  sale_ends_at     DateTime? @db.Timestamptz(6)
  tax_category     String    @db.Text
  valid_from       DateTime  @db.Timestamptz(6)
  valid_until      DateTime? @db.Timestamptz(6)
  status           String    @default("draft") @db.Text
  revision         Int       @default(1)
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  product          Product   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  creator          User      @relation("PriceCreator", fields: [created_by], references: [id], onDelete: Restrict)
  cart_items       CartItem[]
  order_items      OrderItem[]
  @@unique([id, product_id])
  @@index([product_id, created_at, id])
  @@index([created_by])
  @@map("prices")
}

model CoursePublication {
  id                String        @id @db.Uuid
  course_id         String        @db.Uuid
  course_version_id String        @db.Uuid
  version           Int
  action            String        @db.Text
  actor_user_id     String        @db.Uuid
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  course            Course        @relation(fields: [course_id], references: [id], onDelete: Restrict)
  course_version    CourseVersion @relation(fields: [course_version_id, course_id], references: [id, course_id], onDelete: Restrict)
  actor             User          @relation("PublicationActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  @@index([course_id, created_at, id])
  @@index([actor_user_id])
  @@map("course_publications")
}

// ---------------------------------------------------------------------------
// Phase 3: commerce (cart, order, payment, coupons) and learning access.
// The SQL migration holds the authoritative guards; these models describe the
// same tables for the typed client.
// ---------------------------------------------------------------------------

model LegalDocument {
  id         String                 @id @db.Uuid
  kind       String                 @db.Text
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  versions   LegalDocumentVersion[]
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id           String   @id @db.Uuid
  document_id  String   @db.Uuid
  version      Int
  wording      String   @db.Text
  status       String   @default("draft") @db.Text
  activated_at DateTime? @db.Timestamptz(6)
  activated_by String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  document     LegalDocument @relation(fields: [document_id], references: [id], onDelete: Restrict)
  activations  User?    @relation("LegalActivator", fields: [activated_by], references: [id], onDelete: Restrict)
  acceptances  OrderLegalAcceptance[]
  @@unique([document_id, version])
  @@index([activated_by])
  @@map("legal_document_versions")
}

model CommerceSettings {
  id                     Int      @id @default(1) @db.SmallInt
  sales_enabled          Boolean  @default(false)
  invoice_seller_name    String   @db.Text
  invoice_seller_street  String   @db.Text
  invoice_seller_postal  String   @db.Text
  invoice_seller_city    String   @db.Text
  invoice_seller_country String   @db.Char(2)
  invoice_seller_email   String   @db.Text
  invoice_seller_vat_id  String?  @db.Text
  bank_account_holder    String   @db.Text
  bank_iban              String   @db.Text
  bank_bic               String?  @db.Text
  bank_name              String?  @db.Text
  payment_term_days      Int      @default(14)
  currency               String   @default("EUR") @db.Char(3)
  updated_by             String?  @db.Uuid
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  editor                 User?    @relation("CommerceSettingsEditor", fields: [updated_by], references: [id], onDelete: Restrict)
  @@map("commerce_settings")
}

model Cart {
  id                  String     @id @db.Uuid
  user_id             String?    @db.Uuid
  guest_secret_hash   Bytes?     @db.ByteA
  guest_secret_key_id String?    @db.Text
  email_verified_at   DateTime?  @db.Timestamptz(6)
  currency            String     @default("EUR") @db.Char(3)
  status              String     @default("open") @db.Text
  expires_at          DateTime   @db.Timestamptz(6)
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  user                User?      @relation("CartOwner", fields: [user_id], references: [id], onDelete: Restrict)
  items               CartItem[]
  order               Order?
  email_verifications CheckoutEmailVerification[]
  @@index([user_id, created_at])
  @@map("carts")
}

/// Proof that a guest controls the address used for the order. The raw token
/// only exists inside the outgoing mail; only hashes are stored here.
model CheckoutEmailVerification {
  id              String   @id @db.Uuid
  cart_id         String   @db.Uuid
  email_original  String   @db.Text
  email_canonical String   @db.Text
  token_hash      Bytes    @unique @db.ByteA
  code_hash       Bytes    @db.ByteA
  attempts        Int      @default(0) @db.SmallInt
  expires_at      DateTime @db.Timestamptz(6)
  verified_at     DateTime? @db.Timestamptz(6)
  consumed_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  cart            Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  order           Order?
  @@index([cart_id])
  @@map("checkout_email_verifications")
}

model CartItem {
  cart_id    String   @db.Uuid
  product_id String   @db.Uuid
  price_id   String   @db.Uuid
  quantity   Int      @default(1) @db.SmallInt
  added_at   DateTime @default(now()) @db.Timestamptz(6)
  cart       Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  price      Price    @relation(fields: [price_id, product_id], references: [id, product_id], onDelete: Restrict)
  @@id([cart_id, product_id])
  @@map("cart_items")
}

model Order {
  id                       String    @id @db.Uuid
  order_number             String    @unique @db.Text
  cart_id                  String?   @unique @db.Uuid
  checkout_idempotency_key String    @db.Text
  user_id                  String?   @db.Uuid
  checkout_email_verification_id String? @unique @db.Uuid
  identity_kind            String    @default("account") @db.Text
  paid_via                 String?   @db.Text
  guest_participant_first_name String? @db.Text
  guest_participant_last_name  String? @db.Text
  buyer_email_original     String    @db.Text
  buyer_email_canonical    String    @db.Text
  currency                 String    @db.Char(3)
  payment_method           String    @db.Text
  payment_state            String    @default("awaiting") @db.Text
  fulfillment_state        String    @default("not_ready") @db.Text
  subtotal_gross_cents     BigInt
  discount_cents           BigInt    @default(0)
  total_gross_cents        BigInt
  billing_snapshot         Json
  placed_at                DateTime  @default(now()) @db.Timestamptz(6)
  paid_at                  DateTime? @db.Timestamptz(6)
  paid_confirmed_by        String?   @db.Uuid
  payment_reference        String?   @db.Text
  due_at                   DateTime? @db.Timestamptz(6)
  fulfilled_at             DateTime? @db.Timestamptz(6)
  cancelled_at             DateTime? @db.Timestamptz(6)
  cancelled_reason         String?   @db.Text
  refunded_at              DateTime? @db.Timestamptz(6)
  charged_back_at          DateTime? @db.Timestamptz(6)
  created_by               String?   @db.Uuid
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                     User?     @relation("OrderBuyer", fields: [user_id], references: [id], onDelete: Restrict)
  checkout_email_verification CheckoutEmailVerification? @relation(fields: [checkout_email_verification_id], references: [id], onDelete: Restrict)
  creator                  User?     @relation("OrderCreator", fields: [created_by], references: [id], onDelete: Restrict)
  confirmer                User?     @relation("OrderConfirmer", fields: [paid_confirmed_by], references: [id], onDelete: Restrict)
  cart                     Cart?     @relation(fields: [cart_id], references: [id], onDelete: Restrict)
  items                    OrderItem[]
  acceptances              OrderLegalAcceptance[]
  attempts                 PaymentAttempt[]
  events                   PaymentEvent[]
  coupon                   CouponReservation?
  accesses                 CourseAccess[]
  invoice                  Invoice?
  refunds                  Refund[]
  access_decisions         OrderAccessDecision[]
  credit_notes             CreditNote[]
  disputes                 Dispute[]
  withdrawal_requests      WithdrawalRequest[]
  @@unique([user_id, checkout_idempotency_key])
  @@unique([checkout_email_verification_id, checkout_idempotency_key])
  @@index([user_id, placed_at])
  @@index([buyer_email_canonical, placed_at])
  @@index([payment_state, placed_at])
  @@map("orders")
}

model TaxRate {
  id          String    @id @db.Uuid
  category    String    @db.Text
  rate_bp     Int       @db.Integer
  label       String    @db.Text
  note        String?   @db.Text
  valid_from  DateTime  @db.Timestamptz(6)
  valid_until DateTime? @db.Timestamptz(6)
  is_default  Boolean   @default(false)
  created_by  String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  creator     User?     @relation("TaxRateCreator", fields: [created_by], references: [id], onDelete: Restrict)
  @@unique([category, valid_from])
  @@index([category, valid_from])
  @@map("tax_rates")
}

model OrderItem {
  order_id          String   @db.Uuid
  product_id        String   @db.Uuid
  price_id          String   @db.Uuid
  position          Int
  title_snapshot    String   @db.Text
  variant_snapshot  String?  @db.Text
  quantity          Int      @default(1) @db.SmallInt
  unit_gross_cents  BigInt
  discount_cents    BigInt   @default(0)
  total_gross_cents BigInt
  /// Basis points: 1900 = 19 %. Stored on the position so a document never
  /// recomputes tax from a rate that may have changed since.
  tax_rate_bp       Int      @db.Integer
  net_cents         BigInt
  tax_cents         BigInt
  tax_label         String   @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  price             Price    @relation(fields: [price_id, product_id], references: [id, product_id], onDelete: Restrict)
  courses           OrderItemCourse[]
  refund_allocations RefundAllocation[]
  @@id([order_id, product_id])
  @@unique([order_id, position])
  @@map("order_items")
}

model OrderItemCourse {
  order_id              String @db.Uuid
  order_item_product    String @db.Uuid
  course_id             String @db.Uuid
  course_version_id     String @db.Uuid
  course_title_snapshot String @db.Text
  access_days           Int?
  item                  OrderItem @relation(fields: [order_id, order_item_product], references: [order_id, product_id], onDelete: Restrict)
  course                Course    @relation(fields: [course_id], references: [id], onDelete: Restrict)
  version               CourseVersion @relation(fields: [course_version_id, course_id], references: [id, course_id], onDelete: Restrict)
  @@id([order_id, order_item_product, course_id])
  @@map("order_item_courses")
}

model OrderLegalAcceptance {
  id                        String   @id @db.Uuid
  order_id                  String   @db.Uuid
  legal_document_version_id String   @db.Uuid
  kind                      String   @db.Text
  wording_snapshot          String   @db.Text
  affirmed                  Boolean
  ip_hmac                   Bytes?
  user_agent_hmac           Bytes?
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  order                     Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  version                   LegalDocumentVersion @relation(fields: [legal_document_version_id], references: [id], onDelete: Restrict)
  @@unique([order_id, kind])
  @@map("order_legal_acceptances")
}

model PaymentAttempt {
  id                       String    @id @db.Uuid
  order_id                 String    @db.Uuid
  provider                 String    @db.Text
  environment              String    @db.Text
  provider_session_id      String?   @db.Text
  provider_payment_id      String?   @db.Text
  provider_idempotency_key String    @unique @db.Text
  status                   String    @db.Text
  amount_cents             BigInt
  currency                 String    @db.Char(3)
  confirmed_at             DateTime? @db.Timestamptz(6)
  failure_code             String?   @db.Text
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  order                    Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)
  refunds                  Refund[]
  disputes                 Dispute[]
  @@unique([id, order_id])
  @@index([order_id])
  @@map("payment_attempts")
}

model PaymentEvent {
  id                String   @id @db.Uuid
  order_id          String   @db.Uuid
  provider          String   @db.Text
  environment       String   @db.Text
  provider_event_id String   @db.Text
  event_type        String   @db.Text
  amount_cents      BigInt
  currency          String   @db.Char(3)
  received_at       DateTime @default(now()) @db.Timestamptz(6)
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  @@unique([provider, environment, provider_event_id])
  @@map("payment_events")
}

model Coupon {
  id              String    @id @db.Uuid
  code_original   String    @db.Text
  code_canonical  String    @unique @db.Text
  type            String    @db.Text
  value           BigInt
  currency        String?   @db.Char(3)
  valid_from      DateTime  @default(now()) @db.Timestamptz(6)
  valid_until     DateTime? @db.Timestamptz(6)
  max_redemptions Int?
  active          Boolean   @default(false)
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  creator         User      @relation("CouponCreator", fields: [created_by], references: [id], onDelete: Restrict)
  products        CouponProduct[]
  reservations    CouponReservation[]
  @@map("coupons")
}

model CouponProduct {
  coupon_id  String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  coupon     Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  @@id([coupon_id, product_id])
  @@map("coupon_products")
}

model CouponReservation {
  id          String    @id @db.Uuid
  coupon_id   String    @db.Uuid
  order_id    String    @unique @db.Uuid
  user_id     String?   @db.Uuid
  identity_hmac Bytes?  @db.ByteA
  status      String    @db.Text
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at DateTime? @db.Timestamptz(6)
  coupon      Coupon    @relation(fields: [coupon_id], references: [id], onDelete: Restrict)
  order       Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)
  user        User?     @relation("CouponReservationUser", fields: [user_id], references: [id], onDelete: Restrict)
  @@index([coupon_id, status])
  @@map("coupon_reservations")
}

model CourseAccess {
  exam_attempts     ExamAttempt[]
  @@unique([id, course_version_id])
  id                String    @id @db.Uuid
  user_id           String    @db.Uuid
  course_id         String    @db.Uuid
  course_version_id String    @db.Uuid
  source            String    @db.Text
  order_id          String?   @db.Uuid
  granted_by        String?   @db.Uuid
  starts_at         DateTime  @default(now()) @db.Timestamptz(6)
  ends_at           DateTime? @db.Timestamptz(6)
  revoked_at        DateTime? @db.Timestamptz(6)
  revoke_reason     String?   @db.Text
  suspended_at      DateTime? @db.Timestamptz(6)
  suspend_reason    String?   @db.Text
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  user              User      @relation("CourseAccessUser", fields: [user_id], references: [id], onDelete: Restrict)
  course            Course    @relation(fields: [course_id], references: [id], onDelete: Restrict)
  version           CourseVersion @relation(fields: [course_version_id, course_id], references: [id, course_id], onDelete: Restrict)
  order             Order?    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  granter           User?     @relation("CourseAccessGranter", fields: [granted_by], references: [id], onDelete: Restrict)
  progress          ChapterProgress[]
  access_decisions  OrderAccessDecision[]
  @@index([user_id, created_at])
  @@map("course_access")
}

model ChapterProgress {
  id                String   @id @db.Uuid
  access_id         String   @db.Uuid
  course_version_id String   @db.Uuid
  chapter_id        String   @db.Uuid
  completed_at      DateTime @default(now()) @db.Timestamptz(6)
  access            CourseAccess @relation(fields: [access_id], references: [id], onDelete: Restrict)
  version           CourseVersion @relation(fields: [course_version_id], references: [id], onDelete: Restrict)
  chapter           CourseChapter @relation(fields: [chapter_id, course_version_id], references: [id, course_version_id], onDelete: Restrict)
  @@unique([access_id, chapter_id])
  @@map("chapter_progress")
}

model Invoice {
  id                String   @id @db.Uuid
  order_id          String   @unique @db.Uuid
  invoice_number    String   @unique @db.Text
  issued_at         DateTime @default(now()) @db.Timestamptz(6)
  seller_snapshot   Json
  buyer_snapshot    Json
  lines_snapshot    Json
  total_gross_cents BigInt
  currency          String   @db.Char(3)
  due_at            DateTime? @db.Timestamptz(6)
  payment_reference String?  @db.Text
  recipient_email   String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  credit_notes      CreditNote[]
  @@map("invoices")
}

model Refund {
  id                       String    @id @db.Uuid
  order_id                 String    @db.Uuid
  payment_attempt_id       String    @db.Uuid
  provider                 String    @db.Text
  environment              String    @db.Text
  provider_refund_id       String?   @db.Text
  provider_idempotency_key String    @unique @db.Text
  amount_cents             BigInt
  currency                 String    @db.Char(3)
  status                   String    @db.Text
  reason_code              String    @db.Text
  note                     String?   @db.Text
  requested_by             String    @db.Uuid
  requested_at             DateTime  @default(now()) @db.Timestamptz(6)
  confirmed_at             DateTime? @db.Timestamptz(6)
  last_error_safe          String?   @db.Text
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  order                    Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)
  attempt                  PaymentAttempt @relation(fields: [payment_attempt_id, order_id], references: [id, order_id], onDelete: Restrict)
  requester                User      @relation("RefundRequester", fields: [requested_by], references: [id], onDelete: Restrict)
  allocations              RefundAllocation[]
  access_decisions         OrderAccessDecision[]
  credit_notes             CreditNote[]
  withdrawal_requests      WithdrawalRequest[]
  @@index([order_id, status])
  @@index([payment_attempt_id, status])
  @@map("refunds")
}

model RefundAllocation {
  refund_id          String   @db.Uuid
  order_id           String   @db.Uuid
  order_item_product String   @db.Uuid
  gross_cents        BigInt
  net_cents          BigInt   @default(0)
  tax_cents          BigInt   @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  refund             Refund   @relation(fields: [refund_id], references: [id], onDelete: Restrict)
  item               OrderItem @relation(fields: [order_item_product, order_id], references: [product_id, order_id], onDelete: Restrict)
  @@id([refund_id, order_item_product])
  @@map("refund_allocations")
}

model OrderAccessDecision {
  id         String   @id @db.Uuid
  order_id   String   @db.Uuid
  refund_id  String?  @db.Uuid
  dispute_id String?  @db.Uuid
  access_id  String?  @db.Uuid
  decision   String   @db.Text
  reason     String   @db.Text
  decided_by String   @db.Uuid
  decided_at DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  refund     Refund?  @relation(fields: [refund_id], references: [id], onDelete: Restrict)
  dispute    Dispute? @relation(fields: [dispute_id], references: [id], onDelete: Restrict)
  access     CourseAccess? @relation(fields: [access_id], references: [id], onDelete: Restrict)
  decider    User     @relation("AccessDecisionMaker", fields: [decided_by], references: [id], onDelete: Restrict)
  @@index([order_id, decided_at])
  @@index([refund_id])
  @@index([dispute_id])
  @@map("order_access_decisions")
}

model CreditNote {
  id                  String   @id @db.Uuid
  order_id            String   @db.Uuid
  refund_id           String   @unique @db.Uuid
  original_invoice_id String   @db.Uuid
  document_number     String   @unique @db.Text
  issued_at           DateTime @default(now()) @db.Timestamptz(6)
  issuer_snapshot     Json
  buyer_snapshot      Json
  lines_snapshot      Json
  total_gross_cents   BigInt
  currency            String   @db.Char(3)
  reason_code         String   @db.Text
  note                String?  @db.Text
  recipient_email     String?  @db.Text
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  order               Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  refund              Refund   @relation(fields: [refund_id], references: [id], onDelete: Restrict)
  original_invoice    Invoice  @relation(fields: [original_invoice_id], references: [id], onDelete: Restrict)
  @@index([order_id, issued_at])
  @@map("credit_notes")
}

model Dispute {
  id                  String    @id @db.Uuid
  order_id            String    @db.Uuid
  payment_attempt_id  String    @db.Uuid
  provider            String    @db.Text
  environment         String    @db.Text
  provider_dispute_id String    @db.Text
  amount_cents        BigInt
  currency            String    @db.Char(3)
  status              String    @db.Text
  reason_code         String?   @db.Text
  opened_at           DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at         DateTime? @db.Timestamptz(6)
  /// When the provider last reported this case; null for a case staff typed in.
  last_synced_at      DateTime? @db.Timestamptz(6)
  /// `webhook` or `manual` — a signature-verified report is worth more than a
  /// forwarded e-mail, and the list must be able to say which one it is looking at.
  sync_source         String    @default("manual") @db.Text
  order               Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)
  attempt             PaymentAttempt @relation(fields: [payment_attempt_id, order_id], references: [id, order_id], onDelete: Restrict)
  access_decisions    OrderAccessDecision[]
  @@unique([provider, environment, provider_dispute_id])
  @@index([order_id, status])
  @@index([payment_attempt_id, status])
  @@map("disputes")
}

model WithdrawalRequest {
  id                     String    @id @db.Uuid
  submitted_order_number String?   @db.Text
  contact_email          String?    @db.Text
  contact_email_hmac     Bytes     @db.ByteA
  customer_name          String?   @db.Text
  message                String?   @db.Text
  status                 String    @default("received") @db.Text
  submitted_at           DateTime  @default(now()) @db.Timestamptz(6)
  order_id               String?   @db.Uuid
  identity_verified_at   DateTime? @db.Timestamptz(6)
  processed_by           String?   @db.Uuid
  processed_at           DateTime? @db.Timestamptz(6)
  decision_reason        String?   @db.Text
  refund_id              String?   @db.Uuid
  confirmation_outbox_id String?   @db.Uuid
  /// Set when the readable address was removed; the hash keeps the case identifiable.
  contact_email_scrubbed_at DateTime? @db.Timestamptz(6)
  order                  Order?    @relation(fields: [order_id], references: [id], onDelete: Restrict)
  processor              User?     @relation("WithdrawalProcessor", fields: [processed_by], references: [id], onDelete: Restrict)
  refund                 Refund?   @relation(fields: [refund_id], references: [id], onDelete: Restrict)
  confirmation_outbox    EmailOutbox? @relation(fields: [confirmation_outbox_id], references: [id], onDelete: Restrict)
  verifications          WithdrawalVerification[]
  @@index([status, submitted_at])
  @@index([contact_email_hmac, submitted_at])
  @@index([order_id])
  @@map("withdrawal_requests")
}

model WithdrawalVerification {
  id          String    @id @db.Uuid
  request_id  String    @db.Uuid
  token_hash  Bytes     @unique @db.ByteA
  attempts    Int       @default(0) @db.SmallInt
  expires_at  DateTime  @db.Timestamptz(6)
  verified_at DateTime? @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  request     WithdrawalRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  @@index([request_id])
  @@map("withdrawal_verifications")
}

// Phase 6, chapter-only single-choice foundation. Conditional uniqueness and
// the first evaluator profile (3 questions, 4 options, 3 correct) live in SQL.
model Exam {
  id                String @id @db.Uuid
  course_version_id String @db.Uuid
  chapter_id        String @db.Uuid
  title             String @db.Text
  position          Int
  exam_type         String @default("single_choice_quiz") @db.Text
  question_count    Int @default(3) @db.SmallInt
  option_count      Int @default(4) @db.SmallInt
  pass_rule         Json @default("{\"schema_version\":1,\"kind\":\"min_correct\",\"min_correct\":3}")
  chapter           CourseChapter @relation(fields: [chapter_id, course_version_id], references: [id, course_version_id], onDelete: Restrict)
  pool              QuestionPool?
  attempts          ExamAttempt[]
  @@unique([chapter_id, position])
  @@unique([id, course_version_id])
  @@index([course_version_id])
  @@map("exams")
}
model QuestionPool {
  id        String @id @db.Uuid
  exam_id   String @unique @db.Uuid
  title     String @db.Text
  exam      Exam @relation(fields: [exam_id], references: [id], onDelete: Restrict)
  questions Question[]
  @@unique([id, exam_id])
  @@map("question_pools")
}
model Question {
  revision      Int @default(1)
  id            String @id @db.Uuid
  pool_id       String @db.Uuid
  exam_id       String @db.Uuid
  position      Int
  question_text String @db.Text
  explanation   String @default("") @db.Text
  status        String @default("draft") @db.Text
  pool          QuestionPool @relation(fields: [pool_id, exam_id], references: [id, exam_id], onDelete: Restrict)
  options       AnswerOption[]
  selections    ExamAttemptQuestion[]
  @@unique([pool_id, position])
  @@unique([id, exam_id])
  @@map("questions")
}
model AnswerOption {
  id          String @id @db.Uuid
  question_id String @db.Uuid
  option_text String @db.Text
  position    Int @db.SmallInt
  is_correct  Boolean @default(false)
  question    Question @relation(fields: [question_id], references: [id], onDelete: Restrict)
  selections  ExamAttemptOption[]
  @@unique([question_id, position])
  @@unique([id, question_id])
  @@map("answer_options")
}
model ExamAttempt {
  result ExamAttemptResult?
  id                    String @id @db.Uuid
  access_id             String @db.Uuid
  course_version_id     String @db.Uuid
  exam_id               String @db.Uuid
  attempt_no            Int
  start_idempotency_key String @db.Text
  status                String @default("in_progress") @db.Text
  started_at            DateTime @default(now()) @db.Timestamptz(6)
  submitted_at          DateTime? @db.Timestamptz(6)
  access                CourseAccess @relation(fields: [access_id, course_version_id], references: [id, course_version_id], onDelete: Restrict)
  exam                  Exam @relation(fields: [exam_id, course_version_id], references: [id, course_version_id], onDelete: Restrict)
  questions             ExamAttemptQuestion[]
  @@unique([access_id, exam_id, attempt_no])
  @@unique([access_id, start_idempotency_key])
  @@unique([id, exam_id])
  @@index([exam_id])
  @@map("exam_attempts")
}
model ExamAttemptQuestion {
  prompt String? @db.Text
  rationale String? @db.Text
  attempt_id  String @db.Uuid
  exam_id     String @db.Uuid
  question_id String @db.Uuid
  position    Int @db.SmallInt
  attempt     ExamAttempt @relation(fields: [attempt_id, exam_id], references: [id, exam_id], onDelete: Restrict)
  question    Question @relation(fields: [question_id, exam_id], references: [id, exam_id], onDelete: Restrict)
  options     ExamAttemptOption[]
  @@id([attempt_id, question_id])
  @@unique([attempt_id, position])
  @@index([question_id])
  @@map("exam_attempt_questions")
}
model ExamAttemptOption {
  label String? @db.Text
  correct Boolean?
  answers ExamAttemptAnswer[]
  attempt_id  String @db.Uuid
  question_id String @db.Uuid
  option_id   String @db.Uuid
  position    Int @db.SmallInt
  selection   ExamAttemptQuestion @relation(fields: [attempt_id, question_id], references: [attempt_id, question_id], onDelete: Restrict)
  option      AnswerOption @relation(fields: [option_id, question_id], references: [id, question_id], onDelete: Restrict)
  @@id([attempt_id, question_id, option_id])
  @@unique([attempt_id, question_id, position])
  @@index([option_id])
  @@map("exam_attempt_options")
}

model ExamAttemptAnswer {
  attempt_id String @db.Uuid
  question_id String @db.Uuid
  selected_option_id String @db.Uuid
  option ExamAttemptOption @relation(fields: [attempt_id, question_id, selected_option_id], references: [attempt_id, question_id, option_id], onDelete: Restrict)
  @@id([attempt_id, question_id])
  @@map("exam_attempt_answers")
}
model ExamAttemptResult {
  attempt_id String @id @db.Uuid
  submit_key String @db.Uuid
  correct_count Int @db.SmallInt
  passed Boolean
  rule_version Int @default(1) @db.SmallInt
  evaluated_at DateTime @default(now()) @db.Timestamptz(6)
  attempt ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Restrict)
  @@map("exam_attempt_results")
}

// Composite SQL foreign keys bind this write-once record to the grant and the versioned profile.
model CompletionRecord {
  id                 String   @id @db.Uuid
  access_id          String   @unique @db.Uuid
  course_version_id  String   @db.Uuid
  completion_profile String   @db.Text
  completed_at       DateTime @db.Timestamptz(6)
  evidence_snapshot  Json
  @@map("completion_records")
}

model CertificateTemplate {
  id                String    @id @db.Uuid
  course_version_id String    @db.Uuid
  heading           String
  issuer            String
  created_by        String    @db.Uuid
  approved_by       String?   @db.Uuid
  approved_at       DateTime? @db.Timestamptz(6)
  @@unique([id, course_version_id])
  @@map("certificate_templates")
}
model Certificate {
  id                  String   @id @db.Uuid
  completion_id       String   @db.Uuid
  course_version_id   String   @db.Uuid
  template_id         String   @db.Uuid
  replaces_id         String?  @unique @db.Uuid
  status              String   @default("queued")
  attempts            Int      @default(0)
  retry_at            DateTime @default(now()) @db.Timestamptz(6)
  last_error          String?
  issued_at           DateTime? @db.Timestamptz(6)
  verification_hash   Bytes?   @unique
  document_ciphertext Bytes?
  key_id              String?
  revoked_at          DateTime? @db.Timestamptz(6)
  revoked_by          String?   @db.Uuid
  revoke_reason       String?
  @@map("certificates")
}
